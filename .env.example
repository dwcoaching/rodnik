APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

OVERPASS_API_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OVERPASS_STATUS_URL=https://maps.mail.ru/osm/tools/overpass/api/status

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rodnik
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

GEOCODING_PATH=resources/geocoding/countries.geojson
GEOCODING_CITIES_PATH=resources/geocoding/settlements.txt
GEOCODING_ADMIN1_PATH=resources/geocoding/admin1CodesASCII.txt
GEOCODING_REGIONS_PATH=resources/geocoding/regions.geojson
GEOGRAPHY_COUNTRY_INFO_PATH=resources/geocoding/countryInfo.txt
GEOGRAPHY_RUSSIAN_NAMES_PATH=resources/geocoding/russian-names.tsv
GEOCODING_REFERENCE_PATH=resources/geocoding/rodnik-with-countries.json
GEOCODING_RUSSIA_BORDER_PATH=resources/geocoding/russia-claimed-borders.geojson
GEOCODING_CITY_SCOPE=global
GEOCODING_QUEUE_CONNECTION=database
GEOCODING_QUEUE=geocoding
GEOCODING_REFERENCE_MAX_DISTANCE_KM=0
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_BOT_TOKEN=
